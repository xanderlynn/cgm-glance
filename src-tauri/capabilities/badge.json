{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "badge",
  "description": "Desktop badges only read the snapshot and can be dragged.",
  "windows": ["badge-*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-get-snapshot"
  ]
}
